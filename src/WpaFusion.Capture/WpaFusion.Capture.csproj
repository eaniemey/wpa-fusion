<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console app: starts WPR, typeperf, SEP; captures sync points; writes session.json. Runs elevated. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>wpafusion-capture</AssemblyName>
    <!-- The collector is a standalone self-contained app, so it can run on a supported runtime. net6.0 stays
         for the test project, which hosts the plugins on WPA's .NET 6 runtime. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net6.0</TargetFrameworks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WpaFusion.Common\WpaFusion.Common.csproj" />
    <!-- Capture binds the .tb7 right after collection (the plugins never write input files). -->
    <ProjectReference Include="..\WpaFusion.Tbrw\WpaFusion.Tbrw.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WpaFusion.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.EventTracing.Events" />
    <PackageReference Include="Microsoft.Windows.EventTracing.Metadata" />
  </ItemGroup>
  <ItemGroup>
    <!-- Default Typeperf counter list, passed to typeperf with -cf. See Counters/README.md. -->
    <EmbeddedResource Include="Counters\typeperfinput.txt" LogicalName="WpaFusion.Capture.typeperfinput.txt" />
  </ItemGroup>
</Project>
